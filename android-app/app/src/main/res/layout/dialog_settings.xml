<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connection Settings"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Connection Mode:"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgConnectionMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_blue"
            android:checked="true"
            android:text="Wi-Fi (Local Network)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rbUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_blue"
            android:text="USB Cable (ADB Tunnel)"
            android:textColor="@color/text_white" />

        <RadioButton
            android:id="@+id/rbBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_blue"
            android:text="Bluetooth (PAN / Tethering)"
            android:textColor="@color/text_white" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PC IP Address (For Wi-Fi / Bluetooth):"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPcIp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_round_card"
        android:hint="e.g. 192.168.1.10"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:text="192.168.1.5"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted" />

    <Button
        android:id="@+id/btnSaveConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/accent_blue"
        android:text="Save &amp; Connect"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textStyle="bold" />

</LinearLayout>